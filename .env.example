# Copy to Vercel Project → Settings → Environment Variables (never commit real values).

# Web3Forms — required for the contact form (server-side only).
WEB3FORMS_ACCESS_KEY=
# In Web3Forms dashboard, set notifications to hello@tarsonlinecafe.work (Workspace alias on Josh user).

# Required in production: comma-separated site origins allowed to POST /api/submit-contact.
# Example: https://www.tarsonlinecafe.work,https://tarsonlinecafe.work
CONTACT_ALLOWED_ORIGINS=

# Optional: remove DISCORD_BOT_TOKEN and DISCORD_USER_ID from Vercel — legacy /api/contact was removed.

# Optional: legacy Discord contact API (/api/contact).
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
